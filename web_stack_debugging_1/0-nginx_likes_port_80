#!/usr/bin/env bash
# Configure Nginx to listen on port 80 and serve "Hello Holberton"

# 1. Stop any process using port 80
fuser -k 80/tcp 2>/dev/null || true

# 2. Install nginx if missing
apt-get update -y
apt-get install -y nginx

# 3. Ensure index.html exists
echo "Hello Holberton" > /var/www/html/index.html

# 4. Start nginx
nginx -g 'daemon off;'

